# ========================================================
# AI Clinical Decision Support System (AI-CDSS) - .gitignore
# ========================================================

# 1. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# 2. Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# 3. Datasets & Raw Images (DO NOT COMMIT GIGABYTES TO GIT)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 4. Model Weights & Checkpoints (Large Binaries)
data/models/*.pth
data/models/*.pt
data/models/*.onnx
data/models/*.h5
!data/models/.gitkeep

# 5. Dynamic Uploads & Generated Heatmaps
backend/uploads/*
!backend/uploads/.gitkeep
*.log

# 6. Flutter & Dart
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec
frontend/macos/Pods/

# 7. IDE & Operating System Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
